<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.patricedouge.ghostty-sessions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>/Users/patricedouge/.local/bin/ghostty-sessions snapshot --quiet</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/patricedouge/.local/state/ghostty-sessions/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/patricedouge/.local/state/ghostty-sessions/launchd.log</string>
</dict>
</plist>
